{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "isolatedModules": true
        }
      }
    ]
  },
  "testEnvironment": "node",
  "testTimeout": 30000,
  "roots": ["<rootDir>/test"]
}
