{
  "name": "algogo",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild:algogo": "rm -rf ./dist/apps/algogo",
    "prebuild:crawler": "rm -rf ./dist/apps/crawler",
    "prebuild:compiler": "rm -rf ./dist/apps/compiler",
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "dev": "NODE_ENV=development nest start --watch",
    "build:algogo": "pnpm prebuild:algogo && nest build algogo",
    "dev:algogo": "pnpm prebuild:algogo && NODE_ENV=development nest start algogo --watch",
    "dev:compiler": "pnpm prebuild:compiler && NODE_ENV=development nest start compiler --watch",
    "dev:crawler": "pnpm prebuild:crawler && NODE_ENV=development nest start crawler --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "npx prisma generate --schema=./libs/shared-prisma/prisma/schema.prisma",
    "prisma:studio": "npx prisma studio --schema=./libs/shared-prisma/prisma/schema.prisma",
    "prisma:migrate": "npx prisma migrate dev --schema=./libs/shared-prisma/prisma/schema.prisma",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "test:crawler:e2e": "jest --config ./apps/crawler/test/jest-e2e.json",
    "typecheck": "tsc --noEmit",
    "test:nest12": "node --env-file=.test.env --test test/nest12.smoke.cjs",
    "test:local:prepare": "node test/prepare-local-infra.cjs",
    "test:local:db": "node --env-file=.test.env test/provision-local-db.cjs",
    "test:local:e2e": "node --env-file=.test.env --experimental-vm-modules node_modules/jest/bin/jest.js --config test/jest-e2e.json --runInBand",
    "test:local:services": "node --env-file=.test.env --test test/nest12.services.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.842.0",
    "@keyv/redis": "^4.5.0",
    "@nestjs/axios": "^12.0.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/event-emitter": "^12.0.0",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.0.1",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/websockets": "^12.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.72.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@prisma/client": "^5.22.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@willsoto/nestjs-prometheus": "^6.1.1",
    "axios": "^1.15.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.56.1",
    "cache-manager": "^7.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "crypto-js": "^4.2.0",
    "helmet": "^7.2.0",
    "joi": "^18.2.8",
    "jsonwebtoken": "^9.0.2",
    "keyv": "^5.3.4",
    "nestjs-cls": "^6.3.0",
    "node-html-parser": "^6.1.13",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-oauth2": "^1.8.0",
    "pidusage": "^3.0.2",
    "prisma": "^5.22.0",
    "prom-client": "^15.1.3",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.2.2",
    "request-ip": "^3.3.0",
    "rxjs": "^7.8.2",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.3",
    "uuidv7": "^1.0.2",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-loki": "^6.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.23",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.4",
    "@types/oauth": "^0.9.6",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-oauth2": "^1.8.0",
    "@types/request-ip": "^0.0.41",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.5.1",
    "prettier": "^3.6.2",
    "prisma-markdown": "^1.0.9",
    "socket.io-client": "^4.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "isolatedModules": true
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "pnpm": {
    "overrides": {
      "axios": ">=1.15.0",
      "socket.io-parser": ">=4.2.6",
      "fast-xml-parser": ">=4.5.5",
      "flatted": ">=3.4.2",
      "form-data": ">=4.0.4",
      "validator": ">=13.15.22",
      "minimatch@<4": ">=3.1.3",
      "minimatch@>=5 <5.1.8": ">=5.1.8",
      "jws": ">=3.2.3",
      "qs": ">=6.14.2",
      "js-yaml@<3.14.2": ">=3.14.2",
      "@smithy/config-resolver": ">=4.4.0"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "unrs-resolver",
      "@parcel/watcher",
      "msgpackr-extract",
      "protobufjs"
    ]
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.32.1"
}
